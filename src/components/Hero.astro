---
import { hero, site } from '../content/site';
import { emphasise } from '../lib/text';
import T from './T.astro';

const parts = emphasise(hero.heading);
---

<section class="hero" id="top">
  <div class="hero__aura" aria-hidden="true"></div>

  <div class="shell hero__inner">
    <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>

    <h1 class="hero__heading">
      {parts.map((p) => (p.mark ? <em>{p.text}</em> : <>{p.text}</>))}
    </h1>

    <p class="hero__body"><T text={hero.body} /></p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
      <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>

    <p class="hero__where"><T text={site.location} /></p>
  </div>

  <div class="hero__scroll" aria-hidden="true"><span></span></div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(88svh, 54rem);
    padding-block: clamp(4rem, 12vh, 8rem) clamp(5rem, 14vh, 9rem);
    overflow: hidden;
    isolation: isolate;
  }

  /* A slow, barely-there breath of colour behind the words. */
  .hero__aura {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 120%;
    z-index: -1;
    background:
      radial-gradient(48% 42% at 22% 30%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 68%),
      radial-gradient(42% 40% at 78% 62%, color-mix(in srgb, var(--ground-deep) 16%, transparent), transparent 70%);
    filter: blur(28px);
    opacity: 0.85;
    animation: breathe 26s var(--ease) infinite alternate;
  }
  @keyframes breathe {
    from { transform: translate3d(-2%, 0, 0) scale(1); }
    to   { transform: translate3d(2%, -3%, 0) scale(1.08); }
  }

  .hero__inner { max-width: 54rem; }
  .hero__eyebrow { margin-bottom: 1.75rem; }

  .hero__heading {
    font-size: var(--step-6);
    line-height: 1.02;
    letter-spacing: -0.032em;
  }
  .hero__heading em {
    font-style: italic;
    color: var(--accent-ink);
  }

  .hero__body {
    max-width: 42ch;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .hero__where {
    margin-top: 2rem;
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    translate: -50% 0;
    width: 1px;
    height: 3.5rem;
    background: var(--rule-strong);
    overflow: hidden;
  }
  .hero__scroll span {
    display: block;
    width: 100%;
    height: 40%;
    background: var(--accent);
    animation: drop 2.8s var(--ease) infinite;
  }
  @keyframes drop {
    0%   { transform: translateY(-100%); }
    60%  { transform: translateY(250%); }
    100% { transform: translateY(250%); }
  }
  @media (max-width: 48rem) { .hero__scroll { display: none; } }
</style>
