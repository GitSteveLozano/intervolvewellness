---
import { booking, contact } from '../content/site';
import { isTodo } from '../lib/text';

// A scheduler only embeds once it has been configured with real events or a
// real URL — until then the section falls back to an email CTA and loads
// nothing third-party at all.
const events = booking.provider === 'calendly' ? booking.events : [];
const singleUrl = Boolean(booking.url) && !isTodo(booking.url);

const configured =
  booking.provider === 'calendly' ? events.length > 0
  : booking.provider === 'cal' ? Boolean(booking.calLink)
  : booking.provider === 'acuity' ? singleUrl
  : false;

const acuitySrc =
  booking.provider === 'acuity' && configured
    ? `${booking.url}${booking.url.includes('?') ? '&' : '?'}embedded=true`
    : '';
---

<section class="section section--deep" id="book">
  <div class="shell shell--narrow book">
    <p class="eyebrow">Booking</p>
    <h2>{booking.heading}</h2>
    <p class="lede">{booking.body}</p>

    {configured ? (
      <div class="book__embed">
        {booking.provider === 'calendly' && (
          <>
            {events.length > 1 && (
              <div class="picker" role="tablist" aria-label="Choose a session type">
                {events.map((event, i) => (
                  <button
                    class="picker__tab"
                    type="button"
                    role="tab"
                    id={`tab-${i}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    aria-controls="calendly-host"
                    data-url={event.url}
                  >
                    <span class="picker__label">{event.label}</span>
                    <span class="picker__meta">{event.meta}</span>
                  </button>
                ))}
              </div>
            )}

            <div
              id="calendly-host"
              class="calendly-inline-widget"
              role="tabpanel"
              aria-labelledby="tab-0"
              data-url={events[0].url}
              data-first={events[0].url}
              style="min-width:320px;height:760px"
            ></div>
          </>
        )}

        {booking.provider === 'acuity' && (
          <iframe
            src={acuitySrc}
            title="Schedule a session"
            width="100%"
            height="800"
            frameborder="0"
            loading="lazy"
          ></iframe>
        )}

        {booking.provider === 'cal' && (
          <div id="cal-inline" data-cal-link={booking.calLink}></div>
        )}

        <p class="book__alt">
          Trouble with the scheduler?
          <a href={`mailto:${contact.email}`}>Email instead</a>.
        </p>
      </div>
    ) : (
      <div class="book__fallback">
        <p class="book__fallback-note">
          <strong>Scheduler not connected yet.</strong>
          Set <code>booking.provider</code> and its events or URL in
          <code>src/content/site.ts</code> to embed a scheduler here.
        </p>
        <a class="btn btn--primary" href={`mailto:${contact.email}`}>Email to arrange a session</a>
      </div>
    )}
  </div>
</section>

{booking.provider === 'calendly' && configured && (
  <script is:inline defer src="https://assets.calendly.com/assets/external/widget.js"></script>
)}

{booking.provider === 'calendly' && configured && (
  <script is:inline>
    (function () {
      const host = document.getElementById('calendly-host');
      const tabs = Array.from(document.querySelectorAll('.picker__tab'));
      if (!host || tabs.length < 2) return;

      // Calendly auto-initialises the first widget from its data-url. Swapping
      // events means emptying the container and asking it to initialise again,
      // so wait for the script rather than assuming it has loaded.
      const whenReady = (fn) => {
        if (window.Calendly) return fn();
        const timer = setInterval(() => {
          if (!window.Calendly) return;
          clearInterval(timer);
          fn();
        }, 100);
        setTimeout(() => clearInterval(timer), 15000);
      };

      let current = host.dataset.first;

      const show = (url) => {
        if (url === current) return;
        current = url;
        whenReady(() => {
          host.innerHTML = '';
          window.Calendly.initInlineWidget({ url, parentElement: host });
        });
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          host.setAttribute('aria-labelledby', tab.id);
          show(tab.dataset.url);
        });
      });
    })();
  </script>
)}

<style>
  .book { text-align: center; }
  .book h2 { font-size: var(--step-4); }
  .book .lede {
    margin: 1.25rem auto 0;
    max-width: 44ch;
    font-size: var(--step-1);
  }

  .book__embed {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--ground-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-height: 30rem;
  }
  .book__embed iframe { display: block; border: 0; }

  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .picker__tab {
    flex: 1 1 12rem;
    display: grid;
    gap: 0.2rem;
    padding: 1.1rem 1rem;
    background: var(--ground-2);
    border: 0;
    border-bottom: 2px solid transparent;
    font-family: inherit;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .picker__tab:hover { color: var(--ink); }
  .picker__tab[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .picker__label {
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .picker__meta {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .book__alt {
    padding: 1rem;
    font-size: var(--step--1);
    background: var(--ground-2);
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
  }
  .book__alt a { margin-left: 0.4em; }

  .book__fallback {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px dashed rgba(242, 241, 237, 0.32);
    border-radius: var(--radius-lg);
    display: grid;
    gap: 1.75rem;
    justify-items: center;
  }
  .book__fallback-note { max-width: 52ch; font-size: var(--step--1); line-height: 1.7; }
  .book__fallback-note strong { display: block; color: var(--accent-lift); }
  .book__fallback code {
    font-size: 0.9em;
    padding: 0.1em 0.4em;
    border-radius: 3px;
    background: rgba(242, 241, 237, 0.12);
  }
</style>
