---
import { faq } from '../content/site';
import { isTodo } from '../lib/text';
import T from './T.astro';

// Only publish FAQ structured data once the answers are real — Google
// penalises placeholder markup, and "TODO" in a rich result is worse than none.
const ready = faq.items.filter((item) => !isTodo(item.q) && !isTodo(item.a));
const schema = ready.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: ready.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    }
  : null;
---

<section class="section" id="faq">
  <div class="shell faq">
    <div class="faq__head reveal">
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2>{faq.heading}</h2>
    </div>

    <div class="faq__list">
      {faq.items.map((item, i) => (
        <details class="qa reveal" style={`transition-delay:${i * 60}ms`} name="faq">
          <summary>
            <span class="qa__q"><T text={item.q} /></span>
            <span class="qa__icon" aria-hidden="true"></span>
          </summary>
          <div class="qa__a"><p><T text={item.a} /></p></div>
        </details>
      ))}
    </div>
  </div>

  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</section>

<style>
  .faq { display: grid; gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  @media (min-width: 58rem) {
    .faq { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr); }
    .faq__head { position: sticky; top: 7rem; }
  }
  .faq__head h2 { font-size: var(--step-4); }

  .qa { border-top: 1px solid var(--rule); }
  .qa:last-child { border-bottom: 1px solid var(--rule); }

  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker { display: none; }

  .qa__q {
    font-family: var(--display);
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .qa__icon {
    position: relative;
    flex: none;
    width: 1.1rem; height: 1.1rem;
  }
  .qa__icon::before, .qa__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--accent);
    transition: transform 0.3s var(--ease);
  }
  .qa__icon::after { rotate: 90deg; }
  .qa[open] .qa__icon::after { transform: scaleX(0); }

  .qa__a { padding-bottom: 1.5rem; max-width: var(--measure); }
  .qa__a p { color: var(--ink-soft); }
</style>
