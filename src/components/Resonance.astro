---
import { resonance } from '../content/site';
import T from './T.astro';
---

<section class="section section--band" id="resonance">
  <div class="shell resonance">
    <div class="resonance__head reveal">
      <h2>{resonance.heading}</h2>
      <p class="lede"><T text={resonance.intro} /></p>
    </div>

    <ul class="resonance__list">
      {resonance.items.map((item, i) => (
        <li class="reveal" style={`transition-delay:${i * 90}ms`}>
          <span class="resonance__glyph" aria-hidden="true"></span>
          <T text={item} />
        </li>
      ))}
    </ul>

    <p class="resonance__close reveal"><T text={resonance.close} /></p>
  </div>
</section>

<style>
  .resonance { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 60rem) {
    .resonance {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: start;
      column-gap: clamp(3rem, 7vw, 7rem);
    }
    .resonance__close { grid-column: 2; }
  }

  .resonance__head h2 { font-size: var(--step-4); }
  .resonance__head .lede {
    margin-top: 1.5rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .resonance__list { list-style: none; padding: 0; display: grid; gap: 0; }
  .resonance__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .resonance__list li:last-child { border-bottom: 1px solid var(--rule); }

  .resonance__glyph {
    width: 7px; height: 7px;
    border-radius: 999px;
    background: var(--accent);
    translate: 0 -0.35em;
  }

  .resonance__close {
    font-family: var(--display);
    font-size: var(--step-2);
    font-style: italic;
    line-height: 1.35;
    color: var(--accent-ink);
    max-width: 34ch;
  }
</style>
